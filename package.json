{
  "name": "be_clinic",
  "private": true,
  "version": "0.0.1",
  "type": "commonjs",
  "scripts": {
    "start": "nest start",
    "dev": "nest start --watch",
    "build": "npx prisma generate && nest build",
    "postinstall": "npx prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:push": "prisma db push",
    "prisma:push:prod": "node -e \"process.env.ENV_FILE='.env.production'; require('child_process').execSync('npx prisma db push', {stdio: 'inherit', env: process.env})\"",
    "prisma:reset:prod": "node -e \"process.env.ENV_FILE='.env.production'; require('child_process').execSync('npx prisma db push --force-reset', {stdio: 'inherit', env: process.env})\"",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed",
    "seed:prisma": "node prisma/seed.mjs",
    "seed:prod": "node -e \"process.env.ENV_FILE='.env.production'; require('child_process').execSync('node prisma/seed.mjs', {stdio: 'inherit', env: process.env})\"",
    "migrate:auth:mongo-to-prisma": "node scripts/migrate-auth-to-prisma.mjs",
    "migrate:admin:mongo-to-prisma": "node scripts/migrate-admin-mongo-to-prisma.mjs",
    "seed:booking": "node scripts/seed-booking.mjs",
    "seed:users": "node scripts/seed-users.mjs",
    "start:legacy": "node server.mjs",
    "dev:legacy": "node --watch server.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10.4.8",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.4.8",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/morgan": "^1.9.10",
    "@types/ms": "^2.1.0",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "amqplib": "^2.0.1",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "google-auth-library": "^11.0.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.12.0",
    "mongoose": "^8.19.1",
    "morgan": "^1.11.0",
    "ms": "^2.1.3",
    "nodemailer": "^8.0.7",
    "passport": "^0.7.0",
    "passport-anonymous": "^1.0.1",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.8",
    "@nestjs/schematics": "^10.1.4",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.3",
    "@types/node": "^22.10.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
