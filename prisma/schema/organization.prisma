// ============================================================
// Tổ chức: Chi nhánh và phòng khám trong một hệ thống VitaCare
// ============================================================

model Branch {
  id              Int                       @id @default(autoincrement())
  code            String                    @unique @db.VarChar(30)
  slug            String                    @unique @db.VarChar(120)
  name            String                    @db.VarChar(150)
  address         String
  province        String                    @map("province") @db.VarChar(100)
  district        String?                   @map("district") @db.VarChar(100)
  ward            String                    @map("ward") @db.VarChar(100)
  latitude        Float?                    @map("latitude")
  longitude       Float?                    @map("longitude")
  phoneNumber     String                    @map("phone_number") @db.VarChar(20)
  email           String?                   @map("email") @db.VarChar(100)
  imageUrl        String                    @map("image_url") @db.VarChar(500)
  description     String?                   @map("description")
  operatingHours  String?                   @map("operating_hours") @db.VarChar(100)
  openTime        String                    @map("open_time") @db.VarChar(10)
  closeTime       String                    @map("close_time") @db.VarChar(10)
  timezone        String                    @default("Asia/Ho_Chi_Minh") @db.VarChar(500)
  isActive        Boolean                   @default(true) @map("is_active")
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  servicePackages PackageBranch[]
  rooms           ClinicRoom[]
  users           User[]
  scheduleExceptions DoctorScheduleException[]
  schedules       DoctorSchedule[]
  issuedInvoices  Invoice[]
  bookingMethods  BranchBookingMethod[]
  packageReceptionTimes PackageReceptionTime[]
  specialties     BranchSpecialty[]

  @@map("branches")

}

model BranchSpecialty {
  id          Int       @id @default(autoincrement())
  branchId    Int       @map("branch_id")
  specialtyId Int       @map("specialty_id")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@unique([branchId, specialtyId])
  @@index([specialtyId, isActive])
  @@index([branchId, isActive])
  @@map("branch_specialties")
}

model BookingMethod {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(150)
  description String   @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  servicePackages ServicePackage[]
  branches    BranchBookingMethod[]
  appointments Appointment[]

  @@index([isActive, name])
  @@map("booking_methods")
}

model BranchBookingMethod {
  id              Int      @id @default(autoincrement())
  branchId        Int      @map("branch_id")
  bookingMethodId Int      @map("booking_method_id")
  isEnabled       Boolean  @default(true) @map("is_enabled")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  branch          Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  bookingMethod   BookingMethod @relation(fields: [bookingMethodId], references: [id], onDelete: Restrict)

  @@unique([branchId, bookingMethodId])
  @@index([branchId, isEnabled, sortOrder])
  @@index([bookingMethodId])
  @@map("branch_booking_methods")
}

model ClinicRoom {
  id        Int      @id @default(autoincrement())
  branchId  Int      @map("branch_id")
  code      String   @db.VarChar(30)
  name      String   @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  schedules DoctorSchedule[]
  specialties ClinicRoomSpecialty[]

  @@unique([branchId, code])
  @@map("clinic_rooms")
}

model ClinicRoomSpecialty {
  id          Int        @id @default(autoincrement())
  roomId      Int        @map("room_id")
  specialtyId Int        @map("specialty_id")
  priority    Int        @default(0)
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  room        ClinicRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  specialty   Specialty  @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@unique([roomId, specialtyId])
  @@index([specialtyId, isActive, priority])
  @@map("clinic_room_specialties")
}
