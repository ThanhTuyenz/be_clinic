model Clinic {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(150)
  slug      String   @unique @db.VarChar(150)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  branches  Branch[]

  @@map("clinics")
}

model Branch {
  id                 String                    @id @default(uuid()) @db.Uuid
  clinicId           String                    @map("clinic_id") @db.Uuid
  code               String                    @unique @db.VarChar(30)
  name               String                    @db.VarChar(150)
  address            String?
  phoneNumber        String?                   @map("phone_number") @db.VarChar(20)
  timezone           String                    @default("Asia/Ho_Chi_Minh") @db.VarChar(50)
  isActive           Boolean                   @default(true) @map("is_active")
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  clinic             Clinic                    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  rooms              ClinicRoom[]
  userAssignments    UserBranchAssignment[]
  scheduleTemplates  DoctorScheduleTemplate[]
  scheduleExceptions DoctorScheduleException[]
  schedules          DoctorSchedule[]
  appointments       Appointment[]
  issuedInvoices     Invoice[]
  medicalVisits      MedicalVisit[]
  inventoryStocks    InventoryStock[]
  inventoryMovements InventoryMovement[]
  bookingMethods     BranchBookingMethod[]
  specialties        BranchSpecialty[]

  @@index([clinicId, isActive])
  @@map("branches")
}

model BranchSpecialty {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId    String    @map("branch_id") @db.Uuid
  specialtyId Int       @map("specialty_id")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@unique([branchId, specialtyId])
  @@index([specialtyId, isActive])
  @@index([branchId, isActive])
  @@map("branch_specialties")
}

model BookingMethod {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(150)
  description String?  @db.Text
  route       String?  @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  branches    BranchBookingMethod[]

  @@index([isActive, name])
  @@map("booking_methods")
}

model BranchBookingMethod {
  id              String   @id @default(uuid()) @db.Uuid
  branchId        String   @map("branch_id") @db.Uuid
  bookingMethodId String   @map("booking_method_id") @db.Uuid
  isEnabled       Boolean  @default(true) @map("is_enabled")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  branch          Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  bookingMethod   BookingMethod @relation(fields: [bookingMethodId], references: [id], onDelete: Restrict)
  servicePackages   ServicePackage[]

  @@unique([branchId, bookingMethodId])
  @@index([branchId, isEnabled, sortOrder])
  @@index([bookingMethodId])
  @@map("branch_booking_methods")
}

model InventoryStock {
  branchId   String   @map("branch_id") @db.Uuid
  medicineId String   @map("medicine_id") @db.Uuid
  quantity   Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  medicine   Medicine @relation(fields: [medicineId], references: [id], onDelete: Restrict)

  @@id([branchId, medicineId])
  @@map("inventory_stocks")
}

model InventoryMovement {
  id          BigInt                @id @default(autoincrement())
  branchId    String                @map("branch_id") @db.Uuid
  medicineId  String                @map("medicine_id") @db.Uuid
  type        InventoryMovementType
  quantity    Decimal               @db.Decimal(14, 2)
  referenceId String?               @map("reference_id") @db.VarChar(100)
  note        String?               @db.Text
  createdById String                @map("created_by_id") @db.Uuid
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  branch      Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  medicine    Medicine              @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  createdBy   User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([branchId, medicineId, createdAt])
  @@index([referenceId])
  @@map("inventory_movements")
}

model ClinicRoom {
  id        String           @id @default(uuid()) @db.Uuid
  branchId  String           @map("branch_id") @db.Uuid
  code      String           @db.VarChar(30)
  name      String           @db.VarChar(100)
  isActive  Boolean          @default(true) @map("is_active")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  branch    Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  schedules DoctorSchedule[]
  servicePackageSchedules ServicePackageSchedule[]

  @@unique([branchId, code])
  @@map("clinic_rooms")
}

model UserBranchAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([branchId])
  @@map("user_branch_assignments")
}
