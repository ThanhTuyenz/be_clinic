// ============================================================
// Thanh toán: Invoice gắn BookingOrder (hỗ trợ nhóm)
// ============================================================

model Invoice {
  id             String               @id @default(uuid()) @db.Uuid
  bookingOrderId String               @unique @map("booking_order_id") @db.Uuid
  issuedBranchId Int                  @map("issued_branch_id")
  subtotal       Decimal              @default(0) @map("subtotal") @db.Decimal(12, 2)
  serviceFee     Decimal              @default(0) @map("service_fee") @db.Decimal(12, 2)
  discountAmount Decimal              @default(0) @map("discount_amount") @db.Decimal(12, 2)
  voucherCode    String?              @map("voucher_code") @db.VarChar(50)
  totalAmount    Decimal              @map("total_amount") @db.Decimal(12, 2)
  status         InvoiceStatus        @default(UNPAID)
  paidAt         DateTime?            @map("paid_at") @db.Timestamptz(3)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  bookingOrder   BookingOrder         @relation(fields: [bookingOrderId], references: [id], onDelete: Restrict)
  issuedBranch   Branch               @relation(fields: [issuedBranchId], references: [id], onDelete: Restrict)
  payments       PaymentTransaction[]

  @@index([issuedBranchId, status, createdAt])
  @@map("invoices")
}

model PaymentTransaction {
  id                    String        @id @default(uuid()) @db.Uuid
  invoiceId             String        @map("invoice_id") @db.Uuid
  provider              String        @db.VarChar(50)
  providerTransactionId String?       @unique @map("provider_transaction_id") @db.VarChar(255)
  idempotencyKey        String        @unique @map("idempotency_key") @db.VarChar(255)
  method                PaymentMethod
  amount                Decimal       @db.Decimal(12, 2)
  status                PaymentStatus @default(PENDING)
  rawPayload            Json?         @map("raw_payload")
  paidAt                DateTime?     @map("paid_at") @db.Timestamptz(3)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  invoice               Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId, status])
  @@map("payment_transactions")
}
