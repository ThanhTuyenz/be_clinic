// ============================================================
// Danh mục gói khám – phục vụ Smart Booking
// ============================================================

model ServicePackage {
  id                    String   @id @default(uuid()) @db.Uuid
  branchBookingMethodId String   @map("branch_booking_method_id") @db.Uuid
  specialtyId           Int?     @map("specialty_id")
  code                  String   @unique @db.VarChar(50)
  name                  String   @db.VarChar(150)
  description           String?  @db.Text
  price                 Decimal  @db.Decimal(12, 2)
  durationMin           Int      @default(30) @map("duration_min")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branchBookingMethod BranchBookingMethod    @relation(fields: [branchBookingMethodId], references: [id], onDelete: Restrict)
  specialty           Specialty?             @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  schedules           ServicePackageSchedule[]
  appointments        Appointment[]

  @@index([branchBookingMethodId, specialtyId, isActive])
  @@map("service_packages")
}

model ServicePackageSchedule {
  id               String   @id @default(uuid()) @db.Uuid
  servicePackageId String   @map("service_package_id") @db.Uuid
  roomId           String?  @map("room_id") @db.Uuid
  examDate         DateTime @map("exam_date") @db.Date
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  servicePackage ServicePackage               @relation(fields: [servicePackageId], references: [id], onDelete: Cascade)
  room           ClinicRoom?                  @relation(fields: [roomId], references: [id], onDelete: SetNull)
  slots          ServicePackageScheduleSlot[]

  @@unique([servicePackageId, examDate])
  @@index([examDate, isActive])
  @@map("service_package_schedules")
}

model ServicePackageScheduleSlot {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scheduleId      String   @map("schedule_id") @db.Uuid
  startTime       DateTime @map("start_time") @db.Time(0)
  endTime         DateTime @map("end_time") @db.Time(0)
  capacity        Int      @default(20)
  occupiedCount   Int      @default(0) @map("occupied_count")
  nextQueueNumber Int      @default(0) @map("next_queue_number")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  schedule     ServicePackageSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([scheduleId, startTime])
  @@index([scheduleId, isActive])
  @@map("service_package_schedule_slots")
}

