// ============================================================
// Danh mục gói khám – phục vụ Smart Booking
// ============================================================

model ServicePackage {
  id                    String   @id @default(uuid()) @db.Uuid
  branchBookingMethodId String   @map("branch_booking_method_id") @db.Uuid
  specialtyId           Int?     @map("specialty_id")
  code                  String   @unique @db.VarChar(50)
  slug                  String?  @unique @db.VarChar(150)
  name                  String   @db.VarChar(150)
  description           String?  @db.Text
  price                 Decimal  @db.Decimal(12, 2)
  durationMin           Int      @default(30) @map("duration_min")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branchBookingMethod BranchBookingMethod @relation(fields: [branchBookingMethodId], references: [id], onDelete: Restrict)
  specialty           Specialty?          @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  appointments        Appointment[]

  @@index([branchBookingMethodId, specialtyId, isActive])
  @@map("service_packages")
}
