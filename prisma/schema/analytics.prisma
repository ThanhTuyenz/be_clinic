// ============================================================

model SearchRequest {
  id            String   @id @default(uuid()) @db.Uuid
  sessionId     String   @map("session_id") @db.VarChar(100)
  accountId     String?  @map("account_id") @db.Uuid
  branchId      String?  @map("branch_id") @db.Uuid
  query         String   @db.VarChar(200)
  normalizedQuery String @map("normalized_query") @db.VarChar(200)
  intent        Json
  resultKeys    Json     @map("result_keys")
  status        String   @db.VarChar(20)
  packageCount  Int      @map("package_count")
  doctorCount   Int      @map("doctor_count")
  branchCount   Int      @map("branch_count")
  latencyMs     Int      @map("latency_ms")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  interactions AnalyticsInteraction[]
  appointments Appointment[]

  @@index([createdAt, status])
  @@index([branchId, createdAt])
  @@index([sessionId, createdAt])
  @@map("search_requests")
}

model AnalyticsInteraction {
  id          String   @id @db.Uuid
  sessionId   String   @map("session_id") @db.VarChar(100)
  accountId   String?  @map("account_id") @db.Uuid
  searchId    String?  @map("search_id") @db.Uuid
  eventType   String   @map("event_type") @db.VarChar(20)
  targetType  String   @map("target_type") @db.VarChar(20)
  targetId    String   @map("target_id") @db.Uuid
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  position    Int?
  branchId    String?  @map("branch_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  search      SearchRequest? @relation(fields: [searchId], references: [id], onDelete: SetNull)
  appointments Appointment[]

  @@index([eventType, occurredAt])
  @@index([branchId, eventType, occurredAt])
  @@index([searchId, eventType])
  @@index([sessionId, targetId, createdAt])
  @@map("analytics_interactions")
}
// Analytics & Business Intelligence: Search Logs, Snapshots, AI Reports
// ============================================================

model SearchLog {
  id         String   @id @default(uuid()) @db.Uuid
  keyword    String   @db.VarChar(255)
  dateKey    String   @map("date_key") @db.VarChar(10) // YYYY-MM-DD
  count      Int      @default(1)
  hasResults Boolean  @default(true) @map("has_results") // True: có gói khám, False: chưa có dịch vụ đáp ứng
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([keyword, dateKey, hasResults])
  @@index([dateKey, hasResults])
  @@index([keyword])
  @@map("search_logs")
}

model DailyDemandSnapshot {
  id                    String   @id @default(uuid()) @db.Uuid
  dateKey               String   @unique @map("date_key") @db.VarChar(10) // YYYY-MM-DD
  branchId              String?  @map("branch_id") @db.Uuid
  totalSearches         Int      @default(0) @map("total_searches")
  unmatchedSearches     Int      @default(0) @map("unmatched_searches")
  totalPackageViews     Int      @default(0) @map("total_package_views")
  totalBookings         Int      @default(0) @map("total_bookings")
  overallConversionRate Float?   @map("overall_conversion_rate")
  topSpecialtyDemand    String?  @map("top_specialty_demand") @db.VarChar(255)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([dateKey])
  @@map("daily_demand_snapshots")
}

model AiExecutiveReport {
  metricsVersion           String   @default("legacy") @map("metrics_version") @db.VarChar(30)
  id                       String   @id @default(uuid()) @db.Uuid
  timeRange                String   @map("time_range") @db.VarChar(50)
  branchId                 String?  @map("branch_id") @db.Uuid
  overview                 String   @db.Text
  epidemiologicalTrends    Json     @map("epidemiological_trends")
  conversionBottlenecks    Json     @map("conversion_bottlenecks")
  demographicInsights      Json     @map("demographic_insights")
  unmetDemandInsights      Json?    @map("unmet_demand_insights")
  strategicRecommendations Json     @map("strategic_recommendations")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([timeRange, createdAt])
  @@map("ai_executive_reports")
}
