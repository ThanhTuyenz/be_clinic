// ============================================================
// AI Assistant: Conversations & Messages
// ============================================================

enum ConversationType {
  TRIAGE_CONSULTATION    // Tư vấn sàng lọc triệu chứng
  GENERAL_INQUIRY        // Hỏi đáp dịch vụ phòng khám
  BOOKING_ASSISTANCE     // Hỗ trợ đặt lịch
}

enum MessageSender {
  USER
  ASSISTANT
  SYSTEM
}

model Conversation {
  id               String              @id @default(uuid()) @db.Uuid
  userId           String?             @map("user_id") @db.Uuid
  conversationType ConversationType  @default(TRIAGE_CONSULTATION) @map("conversation_type")
  title            String?             @map("title") @db.VarChar(255)
  isClosed         Boolean             @default(false) @map("is_closed")
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  user             User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages         Message[]

  @@index([userId, createdAt])
  @@map("conversations")
}

model Message {
  id                 Int             @id @default(autoincrement())
  conversationId     String          @map("conversation_id") @db.Uuid
  sender             MessageSender @map("sender")
  content            String          @map("content") @db.Text
  rawAudioUrl        String?         @map("raw_audio_url") @db.VarChar(500)
  structuredResponse Json?           @map("structured_response")
  tokensUsed         Int             @default(0) @map("tokens_used")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation       Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}
