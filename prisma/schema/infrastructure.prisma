model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  aggregateType String       @map("aggregate_type") @db.VarChar(100)
  aggregateId   String       @map("aggregate_id") @db.VarChar(100)
  eventType     String       @map("event_type") @db.VarChar(150)
  payload       Json
  status        OutboxStatus @default(PENDING)
  availableAt   DateTime     @default(now()) @map("available_at") @db.Timestamptz(3)
  publishedAt   DateTime?    @map("published_at") @db.Timestamptz(3)
  attempts      Int          @default(0)
  lastError     String?      @map("last_error")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, availableAt])
  @@map("outbox_events")
}

model ProcessedEvent {
  eventId     String   @id @map("event_id") @db.Uuid
  consumer    String   @db.VarChar(150)
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@index([consumer, processedAt])
  @@map("processed_events")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(150)
  targetType String?  @map("target_type") @db.VarChar(100)
  targetId   String?  @map("target_id") @db.VarChar(100)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}
