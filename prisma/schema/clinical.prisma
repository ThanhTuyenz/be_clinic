model PatientProfile {
  id                    String        @id @default(uuid()) @db.Uuid
  accountId             String?       @map("account_id") @db.Uuid
  fullName              String        @map("full_name") @db.VarChar(100)
  nationalId            String?       @unique @map("national_id") @db.VarChar(20)
  healthInsuranceNumber String?       @unique @map("health_insurance_number") @db.VarChar(20)
  dateOfBirth           DateTime      @map("date_of_birth") @db.Date
  gender                Gender?
  address               String?
  relationshipToAccount String        @default("SELF") @map("relationship_to_account") @db.VarChar(50)
  isMainProfile         Boolean       @default(false) @map("is_main_profile")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  account               User?         @relation(fields: [accountId], references: [id], onDelete: SetNull)
  appointments          Appointment[]
  invoices              Invoice[]

  @@index([accountId, isMainProfile])
  @@map("patient_profiles")
}

model Department {
  id          Int         @id @default(autoincrement())
  name        String      @unique @db.VarChar(100)
  description String?
  doctors     Doctor[]
  specialties Specialty[]
  services    MedicalService[]

  @@map("departments")
}

model Specialty {
  id           Int               @id @default(autoincrement())
  departmentId Int               @map("department_id")
  name         String            @db.VarChar(100)
  description  String?
  department   Department        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  doctors      DoctorSpecialty[]

  @@unique([departmentId, name])
  @@map("specialties")
}

model Doctor {
  id                 String                    @id @default(uuid()) @db.Uuid
  userId             String                    @unique @map("user_id") @db.Uuid
  departmentId       Int?                      @map("department_id")
  fullName           String                    @map("full_name") @db.VarChar(100)
  academicRank       String?                   @map("academic_rank") @db.VarChar(50)
  licenseNumber      String?                   @unique @map("license_number") @db.VarChar(50)
  experienceYears    Int                       @default(0) @map("experience_years")
  biography          String?                   @db.Text
  consultationFee    Decimal                   @default(0) @map("consultation_fee") @db.Decimal(12, 2)
  slotDuration       Int                       @default(30) @map("slot_duration")
  ratingAverage      Float                     @default(0.0) @map("rating_average")
  ratingCount        Int                       @default(0) @map("rating_count")
  isFeatured         Boolean                   @default(false) @map("is_featured")
  isActive           Boolean                   @default(true) @map("is_active")
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  department         Department?               @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  specialties        DoctorSpecialty[]
  branchAssignments  DoctorBranchAssignment[]
  scheduleTemplates  DoctorScheduleTemplate[]
  scheduleExceptions DoctorScheduleException[]
  schedules          DoctorSchedule[]
  appointments       Appointment[]
  reviews            Review[]

  @@index([departmentId, isActive])
  @@index([isFeatured, isActive])
  @@map("doctors")
}

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  doctorId   String   @map("doctor_id") @db.Uuid
  reviewerId String   @map("reviewer_id") @db.Uuid
  rating     Int
  comment    String?  @db.Text
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  doctor     Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  reviewer   User     @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([doctorId, reviewerId])
  @@index([doctorId, isActive, createdAt])
  @@index([reviewerId])
  @@map("reviews")
}

model DoctorSpecialty {
  doctorId    String    @map("doctor_id") @db.Uuid
  specialtyId Int       @map("specialty_id")
  isPrimary   Boolean   @default(false) @map("is_primary")
  doctor      Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([doctorId, specialtyId])
  @@map("doctor_specialties")
}

model DoctorBranchAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  doctorId  String   @map("doctor_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([doctorId, branchId])
  @@index([branchId])
  @@map("doctor_branch_assignments")
}
