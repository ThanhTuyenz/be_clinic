// ============================================================
// Hồ sơ bệnh nhân, Bác sĩ, Chuyên khoa – Smart Booking scope
// ============================================================

model PatientProfile {
  id                    String        @id @default(uuid()) @db.Uuid
  accountId             String?       @map("account_id") @db.Uuid
  fullName              String        @map("full_name") @db.VarChar(100)
  nationalId            String?       @unique @map("national_id") @db.VarChar(20)
  healthInsuranceNumber String?       @unique @map("health_insurance_number") @db.VarChar(20)
  dateOfBirth           DateTime      @map("date_of_birth") @db.Date
  gender                Gender?
  address               String?
  relationshipToAccount String        @default("SELF") @map("relationship_to_account") @db.VarChar(50)
  isMainProfile         Boolean       @default(false) @map("is_main_profile")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  account               User?         @relation(fields: [accountId], references: [id], onDelete: SetNull)
  appointments          Appointment[]

  @@index([accountId, isMainProfile])
  @@map("patient_profiles")
}

// Chuyên khoa – không bắt buộc thuộc khoa (Department đã xóa)
model Specialty {
  id           Int               @id @default(autoincrement())
  name         String            @unique @db.VarChar(100)
  slug         String?           @unique @db.VarChar(120)
  description  String?
  iconUrl      String?           @map("icon_url") @db.VarChar(500)
  isActive     Boolean           @default(true) @map("is_active")
  sortOrder    Int               @default(0) @map("sort_order")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  doctors         DoctorSpecialty[]
  servicePackages ServicePackage[]
  medicalServices MedicalService[]
  branches        BranchSpecialty[]
  rooms           ClinicRoomSpecialty[]

  @@index([isActive, sortOrder])
  @@map("specialties")
}

// Bác sĩ – Table-per-Type (1-1 với User)
model Doctor {
  id              String                    @id @default(uuid()) @db.Uuid
  userId          String                    @unique @map("user_id") @db.Uuid
  academicRank    String?                   @map("academic_rank") @db.VarChar(50)
  licenseNumber   String?                   @unique @map("license_number") @db.VarChar(50)
  experienceYears Int                       @default(0) @map("experience_years")
  biography       String?                   @db.Text
  avatarUrl       String?                   @map("avatar_url") @db.VarChar(500)
  consultationFee Decimal                   @default(0) @map("consultation_fee") @db.Decimal(12, 2)
  slotDuration    Int                       @default(30) @map("slot_duration")
  ratingAverage   Float                     @default(0.0) @map("rating_average")
  ratingCount     Int                       @default(0) @map("rating_count")
  isFeatured      Boolean                   @default(false) @map("is_featured")
  isActive        Boolean                   @default(true) @map("is_active")
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialties        DoctorSpecialty[]
  scheduleExceptions DoctorScheduleException[]
  schedules          DoctorSchedule[]
  reviews            Review[]

  @@index([isFeatured, isActive])
  @@map("doctors")
}

// Nhân viên tiếp nhận / Lễ tân – Table-per-Type (1-1 với User)
model Receptionist {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @unique @map("user_id") @db.Uuid
  employeeCode String    @unique @map("employee_code") @db.VarChar(50)
  deskNumber   String?   @map("desk_number") @db.VarChar(50)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@map("receptionists")
}

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  doctorId   String   @map("doctor_id") @db.Uuid
  reviewerId String   @map("reviewer_id") @db.Uuid
  rating     Int
  comment    String?  @db.Text
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  doctor     Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  reviewer   User     @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([doctorId, reviewerId])
  @@index([doctorId, isActive, createdAt])
  @@index([reviewerId])
  @@map("reviews")
}

model DoctorSpecialty {
  doctorId    String    @map("doctor_id") @db.Uuid
  specialtyId Int       @map("specialty_id")
  isPrimary   Boolean   @default(false) @map("is_primary")
  doctor      Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([doctorId, specialtyId])
  @@map("doctor_specialties")
}
