// ============================================================
// Hồ sơ bệnh nhân, Bác sĩ, Chuyên khoa – Smart Booking scope
// ============================================================

model PatientProfile {
  id                    String        @id @default(uuid()) @db.Uuid
  patientCode           String?       @map("patient_code") @db.VarChar(30)
  accountId             String?       @map("account_id") @db.Uuid
  fullName              String        @map("full_name") @db.VarChar(100)
  phoneNumber           String?       @map("phone_number") @db.VarChar(20)
  nationalId            String?       @map("national_id") @db.VarChar(20)
  healthInsuranceNumber String?       @map("health_insurance_number") @db.VarChar(20)
  dateOfBirth           DateTime      @map("date_of_birth") @db.Date
  gender                Gender?
  
  // Địa chỉ 3 cấp hành chính + Địa chỉ chi tiết
  provinceCode          String?       @map("province_code") @db.VarChar(20)
  provinceName          String?       @map("province_name") @db.VarChar(100)
  districtCode          String?       @map("district_code") @db.VarChar(20)
  districtName          String?       @map("district_name") @db.VarChar(100)
  wardCode              String?       @map("ward_code") @db.VarChar(20)
  wardName              String?       @map("ward_name") @db.VarChar(100)
  streetAddress         String?       @map("street_address") @db.VarChar(255)
  address               String?

  // Thông tin hành chính Bộ Y tế
  ethnicity             String?       @map("ethnicity") @db.VarChar(50)
  nationality           String?       @default("Việt Nam") @map("nationality") @db.VarChar(50)
  occupation            String?       @map("occupation") @db.VarChar(100)

  // Người bảo hộ / liên hệ khẩn cấp
  guardianName          String?       @map("guardian_name") @db.VarChar(100)
  guardianPhone         String?       @map("guardian_phone") @db.VarChar(20)
  guardianRelationship  String?       @map("guardian_relationship") @db.VarChar(50)

  // Thông tin sức khỏe & tiền sử y tế hỗ trợ phân tích AI/CDSS
  medicalHistory        String?       @map("medical_history") @db.Text
  allergies             String?       @map("allergies") @db.Text
  bloodGroup            String?       @map("blood_group") @db.VarChar(10)
  height                Float?        @map("height")
  weight                Float?        @map("weight")

  relationshipToAccount String        @default("SELF") @map("relationship_to_account") @db.VarChar(50)
  isMainProfile         Boolean       @default(false) @map("is_main_profile")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  account               User?         @relation(fields: [accountId], references: [id], onDelete: SetNull)
  appointments          Appointment[]

  @@unique([accountId, nationalId])
  @@unique([accountId, healthInsuranceNumber])
  @@index([accountId, isMainProfile])
  @@index([nationalId])
  @@index([healthInsuranceNumber])
  @@index([patientCode])
  @@index([phoneNumber])
  @@map("patient_profiles")
}

// Chuyên khoa – không bắt buộc thuộc khoa (Department đã xóa)
model Specialty {
  id           Int               @id @default(autoincrement())
  name         String            @unique @db.VarChar(100)
  slug         String?           @unique @db.VarChar(120)
  description  String?
  symptoms     String[]          @default([])
  iconUrl      String?           @map("icon_url") @db.VarChar(500)
  isActive     Boolean           @default(true) @map("is_active")
  sortOrder    Int               @default(0) @map("sort_order")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  doctors         DoctorSpecialty[]
  servicePackages ServicePackage[]
  branches        BranchSpecialty[]
  rooms           ClinicRoomSpecialty[]
  aiTriageInsights AITriageInsight[]

  @@index([isActive, sortOrder])
  @@map("specialties")
}

// Bác sĩ – Table-per-Type (1-1 với User)
model Doctor {
  id              String                    @id @default(uuid()) @db.Uuid
  userId          String                    @unique @map("user_id") @db.Uuid
  academicRank    String?                   @map("academic_rank") @db.VarChar(50)
  licenseNumber   String?                   @unique @map("license_number") @db.VarChar(50)
  experienceYears Int                       @default(0) @map("experience_years")
  biography       String?                   @db.Text
  avatarUrl       String?                   @map("avatar_url") @db.VarChar(500)
  consultationFee Decimal                   @default(0) @map("consultation_fee") @db.Decimal(12, 2)
  onlineConsultationFee Decimal?            @map("online_consultation_fee") @db.Decimal(12, 2)
  isOnlineConsultationEnabled Boolean        @default(false) @map("is_online_consultation_enabled")
  slotDuration    Int                       @default(30) @map("slot_duration")
  ratingAverage   Float                     @default(0.0) @map("rating_average")
  ratingCount     Int                       @default(0) @map("rating_count")
  isFeatured      Boolean                   @default(false) @map("is_featured")
  isActive        Boolean                   @default(true) @map("is_active")
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialties        DoctorSpecialty[]
  scheduleExceptions DoctorScheduleException[]
  schedules          DoctorSchedule[]
  aiTriageInsights   AITriageInsight[]

  @@index([isFeatured, isActive])
  @@map("doctors")

}

// Nhân viên tiếp nhận / Lễ tân – Table-per-Type (1-1 với User)
model Receptionist {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @unique @map("user_id") @db.Uuid
  employeeCode String    @unique @map("employee_code") @db.VarChar(50)
  deskNumber   String?   @map("desk_number") @db.VarChar(50)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@map("receptionists")
}

model DoctorSpecialty {
  doctorId    String    @map("doctor_id") @db.Uuid
  specialtyId Int       @map("specialty_id")
  isPrimary   Boolean   @default(false) @map("is_primary")
  doctor      Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([doctorId, specialtyId])
  @@map("doctor_specialties")
}

// ============================================================
// Danh mục gói khám – phục vụ Smart Booking
// ============================================================

model ServicePackage {
  id                    String   @id @default(uuid()) @db.Uuid
  branchBookingMethodId String?  @map("branch_booking_method_id") @db.Uuid
  specialtyId           Int?     @map("specialty_id")
  code                  String   @unique @db.VarChar(50)
  slug                  String?  @unique @db.VarChar(150)
  name                  String   @db.VarChar(150)
  imageUrl              String?  @map("image_url") @db.VarChar(500)
  description           String?  @db.Text
  notes                 String?  @db.Text
  symptoms              String[] @default([])
  price                 Decimal  @db.Decimal(12, 2)
  durationMin           Int      @default(30) @map("duration_min")
  targetGender          PackageGenderTarget @default(ALL) @map("target_gender")
  minAge                Int?     @map("min_age")
  maxAge                Int?     @map("max_age")
  isPediatric           Boolean  @default(false) @map("is_pediatric")
  isFollowUp            Boolean  @default(false) @map("is_follow_up")
  followUpAfterDays     Int?     @map("follow_up_after_days")
  viewCount             Int      @default(0) @map("view_count")
  isFeatured            Boolean  @default(false) @map("is_featured")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branchBookingMethod   BranchBookingMethod?                @relation(fields: [branchBookingMethodId], references: [id], onDelete: SetNull)
  specialty             Specialty?                          @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  appointments          Appointment[]
  branchBookingMethods  ServicePackageBranchBookingMethod[]
  receptionSchedules    PackageReceptionSchedule[]

  @@index([branchBookingMethodId, specialtyId, isActive])
  @@map("service_packages")
}

enum PackageSession {
  MORNING
  AFTERNOON
  EVENING
}

model PackageReceptionSchedule {
  id               String           @id @default(uuid()) @db.Uuid
  servicePackageId String           @map("service_package_id") @db.Uuid
  branchId         String           @map("branch_id") @db.Uuid
  dayOfWeek        Int              @map("day_of_week")
  sessions         PackageSession[]
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  servicePackage   ServicePackage   @relation(fields: [servicePackageId], references: [id], onDelete: Cascade)
  branch           Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([servicePackageId, branchId, dayOfWeek])
  @@index([branchId, servicePackageId])
  @@map("package_reception_schedules")
}

model ServicePackageBranchBookingMethod {
  id                    String              @id @default(uuid()) @db.Uuid
  servicePackageId      String              @map("service_package_id") @db.Uuid
  branchBookingMethodId String              @map("branch_booking_method_id") @db.Uuid
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  servicePackage        ServicePackage      @relation(fields: [servicePackageId], references: [id], onDelete: Cascade)
  branchBookingMethod   BranchBookingMethod @relation(fields: [branchBookingMethodId], references: [id], onDelete: Cascade)

  @@unique([servicePackageId, branchBookingMethodId])
  @@index([branchBookingMethodId])
  @@map("service_package_branch_booking_methods")
}
