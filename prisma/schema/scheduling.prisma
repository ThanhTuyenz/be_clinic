// ============================================================
// Ca làm việc & Khung giờ của bác sĩ
// ============================================================

model DoctorSchedule {
  id               Int            @id @default(autoincrement())
  doctorId         String         @map("doctor_id") @db.Uuid
  branchId         Int            @map("branch_id")
  roomId           Int?           @map("room_id")
  workDate         DateTime       @map("work_date") @db.Date
  startTime        DateTime       @map("start_time") @db.Time(0)
  endTime          DateTime       @map("end_time") @db.Time(0)
  slotDurationMin  Int            @default(30) @map("slot_duration_min")
  capacityPerSlot  Int            @default(1) @map("capacity_per_slot")  // số bệnh nhân tối đa / slot
  status           ScheduleStatus @default(OPEN)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  doctor           Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  branch           Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  room             ClinicRoom?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  slots            DoctorScheduleSlot[]

  @@unique([doctorId, branchId, workDate, startTime])
  @@index([doctorId, workDate, status])
  @@index([branchId, workDate, status])
  @@index([workDate, status])
  @@map("doctor_schedules")
}

model DoctorScheduleSlot {
  id              Int            @id @default(autoincrement())
  scheduleId      Int            @map("schedule_id")
  startTime       DateTime       @map("start_time") @db.Time(0)
  endTime         DateTime       @map("end_time") @db.Time(0)
  capacity        Int            @default(1)
  occupiedCount   Int            @default(0) @map("occupied_count")
  slotStatus      SlotStatus     @default(AVAILABLE) @map("slot_status")
  isActive        Boolean        @default(true) @map("is_active")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  schedule        DoctorSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  appointments    Appointment[]

  @@unique([scheduleId, startTime])
  @@index([scheduleId, slotStatus, isActive])
  @@index([scheduleId, isActive, occupiedCount])
  @@map("doctor_schedule_slots")
}

model PackageReceptionSlot {
  id               Int            @id @default(autoincrement())
  receptionScheduleId Int         @map("reception_schedule_id")
  date             DateTime       @db.Date
  startTime        DateTime       @map("start_time") @db.Time(0)
  endTime          DateTime       @map("end_time") @db.Time(0)
  capacity         Int            @default(5)
  occupiedCount    Int            @default(0) @map("occupied_count")
  isActive         Boolean        @default(true) @map("is_active")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  receptionSchedule PackageReceptionTime @relation(fields: [receptionScheduleId], references: [id], onDelete: Restrict)
  appointments     Appointment[]

  @@unique([receptionScheduleId, date, startTime], map: "package_reception_slot_schedule_date_start_key")
  @@index([receptionScheduleId, date, isActive], map: "package_reception_slot_schedule_date_active_idx")
  @@map("package_reception_slots")
}

model DoctorScheduleException {
  id        Int      @id @default(autoincrement())
  doctorId  String   @map("doctor_id") @db.Uuid
  branchId  Int      @map("branch_id")
  date      DateTime @db.Date
  reason    String?
  isClosed  Boolean  @default(true) @map("is_closed")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([doctorId, branchId, date])
  @@map("doctor_schedule_exceptions")
}
