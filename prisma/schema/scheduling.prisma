model DoctorScheduleTemplate {
  id              String           @id @default(uuid()) @db.Uuid
  doctorId        String           @map("doctor_id") @db.Uuid
  branchId        String           @map("branch_id") @db.Uuid
  dayOfWeek       Int              @map("day_of_week")
  shiftStartTime  DateTime         @map("shift_start_time") @db.Time(0)
  shiftEndTime    DateTime         @map("shift_end_time") @db.Time(0)
  slotDurationMin Int              @map("slot_duration_min")
  defaultCapacity Int              @map("default_capacity")
  validFrom       DateTime         @map("valid_from") @db.Date
  validUntil      DateTime?        @map("valid_until") @db.Date
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  doctor          Doctor           @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  branch          Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  schedules       DoctorSchedule[]

  @@index([doctorId, branchId, dayOfWeek, isActive])
  @@map("doctor_schedule_templates")
}

model DoctorSchedule {
  id         String                  @id @default(uuid()) @db.Uuid
  templateId String?                 @map("template_id") @db.Uuid
  doctorId   String                  @map("doctor_id") @db.Uuid
  branchId   String                  @map("branch_id") @db.Uuid
  roomId     String?                 @map("room_id") @db.Uuid
  workDate   DateTime                @map("work_date") @db.Date
  startTime  DateTime                @map("start_time") @db.Time(0)
  endTime    DateTime                @map("end_time") @db.Time(0)
  status     ScheduleStatus          @default(OPEN)
  createdAt  DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  template   DoctorScheduleTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  doctor     Doctor                  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  branch     Branch                  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  room       ClinicRoom?             @relation(fields: [roomId], references: [id], onDelete: SetNull)
  slots      DoctorScheduleSlot[]

  @@unique([doctorId, branchId, workDate, startTime])
  @@index([branchId, workDate, status])
  @@map("doctor_schedules")
}

model DoctorScheduleSlot {
  id              String         @id @default(uuid()) @db.Uuid
  scheduleId      String         @map("schedule_id") @db.Uuid
  startTime       DateTime       @map("start_time") @db.Time(0)
  endTime         DateTime       @map("end_time") @db.Time(0)
  capacity        Int
  occupiedCount   Int            @default(0) @map("occupied_count")
  nextQueueNumber Int            @default(0) @map("next_queue_number")
  isActive        Boolean        @default(true) @map("is_active")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  schedule        DoctorSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  appointments    Appointment[]

  @@unique([scheduleId, startTime])
  @@index([scheduleId, isActive])
  @@map("doctor_schedule_slots")
}

model DoctorScheduleException {
  id        String   @id @default(uuid()) @db.Uuid
  doctorId  String   @map("doctor_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  date      DateTime @db.Date
  reason    String?
  isClosed  Boolean  @default(true) @map("is_closed")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([doctorId, branchId, date])
  @@map("doctor_schedule_exceptions")
}
