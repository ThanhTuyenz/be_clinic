model User {
  id                    String                  @id @default(uuid()) @db.Uuid
  email                 String?                 @unique @db.VarChar(255)
  password              String?                 @map("password_hash") @db.VarChar(255)
  phoneNumber           String?                 @unique @map("phone_number") @db.VarChar(20)
  fullName              String?                 @map("full_name") @db.VarChar(100)
  provider              AuthProvider            @default(EMAIL)
  status                UserStatus              @default(ACTIVE)
  role                  UserRole                @default(PATIENT)
  roleId                String?                 @map("role_id") @db.VarChar(100)
  socialId              String?                 @map("social_id") @db.VarChar(255)
  customPermissions     Json?                   @map("custom_permissions")
  hash                  String?                 @db.VarChar(255)
  emailOtpHash          String?                 @map("email_otp_hash") @db.VarChar(255)
  emailOtpExpiresAt     DateTime?               @map("email_otp_expires_at") @db.Timestamptz(3)
  emailOtpLastSentAt    DateTime?               @map("email_otp_last_sent_at") @db.Timestamptz(3)
  emailOtpAttempts      Int                     @default(0) @map("email_otp_attempts")
  isBlocked             Boolean                 @default(false) @map("is_blocked")
  blockedAt             DateTime?               @map("blocked_at") @db.Timestamptz(3)
  isDeleted             Boolean                 @default(false) @map("is_deleted")
  lastLoginAt           DateTime?               @map("last_login_at") @db.Timestamptz(3)
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions              Session[]
  oauthAccounts         OAuthAccount[]
  verificationTokens    AuthVerificationToken[]
  passwordResetTokens   PasswordResetToken[]
  branchAssignments     UserBranchAssignment[]
  patientProfiles       PatientProfile[]
  doctor                Doctor?
  handledInvoices       Invoice[]               @relation("CashierInvoices")
  checkedInAppointments Appointment[]           @relation("CheckedInBy")
  auditLogs             AuditLog[]              @relation("AuditActor")
  examinationsCreated   Examination[]

  @@index([role, status])
  @@index([isBlocked, isDeleted])
  @@map("users")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String?   @map("refresh_token_hash") @db.VarChar(255)
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deletedAt])
  @@map("sessions")
}

model OAuthAccount {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  provider          AuthProvider
  providerAccountId String       @map("provider_account_id") @db.VarChar(255)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model AuthVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("auth_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}
