// ============================================================
// Auth: User & OAuth (Session, OTP & Reset Tokens managed in Redis)
// ============================================================

model User {
  id                       String                     @id @default(uuid()) @db.Uuid
  email                    String?                    @unique @db.VarChar(255)
  password                 String?                    @map("password_hash") @db.VarChar(255)
  phoneNumber              String?                    @unique @map("phone_number") @db.VarChar(20)
  fullName                 String?                    @map("full_name") @db.VarChar(100)
  avatarUrl                String?                    @map("avatar_url") @db.VarChar(500)
  provider                 AuthProvider               @default(EMAIL)
  status                   UserStatus                 @default(ACTIVE)
  role                     UserRole                   @default(PATIENT)
  roleId                   String?                    @map("role_id") @db.VarChar(100)
  socialId                 String?                    @map("social_id") @db.VarChar(255)
  zaloId                   String?                    @unique @map("zalo_id") @db.VarChar(255)
  customPermissions        Json?                      @map("custom_permissions")
  hash                     String?                    @db.VarChar(255)
  isBlocked                Boolean                    @default(false) @map("is_blocked")
  blockedAt                DateTime?                  @map("blocked_at") @db.Timestamptz(3)
  isDeleted                Boolean                    @default(false) @map("is_deleted")
  lastLoginAt              DateTime?                  @map("last_login_at") @db.Timestamptz(3)
  createdAt                DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  oauthAccounts            OAuthAccount[]
  branchAssignments        UserBranchAssignment[]
  patientProfiles          PatientProfile[]
  doctor                   Doctor?
  receptionist             Receptionist?
  bookingOrders            BookingOrder[]
  checkedInAppointments    Appointment[]              @relation("CheckedInBy")
  auditLogs                AuditLog[]                 @relation("AuditActor")
  appointmentStatusChanges AppointmentStatusHistory[] @relation("AppointmentStatusActor")
  telehealthSessionsEnded  TelehealthSession[]        @relation("TelehealthSessionEndedBy")
  aiConversations          AIConversation[]
  aiBookingIntentLogs      AIBookingIntentLog[]
  voucherUsages            VoucherUsage[]
  notifications            Notification[]
  deviceTokens             DeviceToken[]

  @@index([role, status])
  @@index([isDeleted, createdAt])
  @@map("users")
}

model OAuthAccount {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  provider          AuthProvider
  providerAccountId String       @map("provider_account_id") @db.VarChar(255)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}
