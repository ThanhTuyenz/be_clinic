generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN          @map("admin")
  BRANCH_MANAGER @map("branch_manager")
  DOCTOR         @map("doctor")
  PHARMACIST     @map("pharmacist")
  CASHIER        @map("cashier")
  RECEPTIONIST   @map("receptionist")
  PATIENT        @map("patient")
}

enum UserStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")
}

enum AuthProvider {
  EMAIL  @map("email")
  GOOGLE @map("google")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ScheduleStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum AppointmentStatus {
  PENDING_PAYMENT
  BOOKED
  CHECKED_IN
  IN_EXAMINATION
  COMPLETED
  CANCELLED
  EXPIRED
  NO_SHOW
  REFUND_REQUIRED
  MANUAL_REVIEW
}

enum InvoiceStatus {
  UNPAID
  PAID
  REFUNDED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
  CANCELLED
  LATE_SUCCESS
  REFUND_REQUIRED
  REFUNDED
  MANUAL_REVIEW
}

enum PaymentMethod {
  CASH
  VIETQR
  POS_CARD
  ONLINE
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

model Clinic {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(150)
  slug      String   @unique @db.VarChar(150)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  branches  Branch[]

  @@map("clinics")
}

model Branch {
  id                 String                    @id @default(uuid()) @db.Uuid
  clinicId           String                    @map("clinic_id") @db.Uuid
  code               String                    @unique @db.VarChar(30)
  name               String                    @db.VarChar(150)
  address            String?
  phoneNumber        String?                   @map("phone_number") @db.VarChar(20)
  timezone           String                    @default("Asia/Ho_Chi_Minh") @db.VarChar(50)
  isActive           Boolean                   @default(true) @map("is_active")
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  clinic             Clinic                    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  rooms              ClinicRoom[]
  userAssignments    UserBranchAssignment[]
  doctorAssignments  DoctorBranchAssignment[]
  scheduleTemplates  DoctorScheduleTemplate[]
  scheduleExceptions DoctorScheduleException[]
  schedules          DoctorSchedule[]
  appointments       Appointment[]
  invoices           Invoice[]

  @@index([clinicId, isActive])
  @@map("branches")
}

model ClinicRoom {
  id        String           @id @default(uuid()) @db.Uuid
  branchId  String           @map("branch_id") @db.Uuid
  code      String           @db.VarChar(30)
  name      String           @db.VarChar(100)
  isActive  Boolean          @default(true) @map("is_active")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  branch    Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  schedules DoctorSchedule[]

  @@unique([branchId, code])
  @@map("clinic_rooms")
}

model User {
  id                    String                  @id @default(uuid()) @db.Uuid
  email                 String?                 @unique @db.VarChar(255)
  password              String?                 @map("password_hash") @db.VarChar(255)
  phoneNumber           String?                 @unique @map("phone_number") @db.VarChar(20)
  fullName              String?                 @map("full_name") @db.VarChar(100)
  provider              AuthProvider            @default(EMAIL)
  status                UserStatus              @default(ACTIVE)
  role                  UserRole                @default(PATIENT)
  roleId                String?                 @map("role_id") @db.VarChar(100)
  socialId              String?                 @map("social_id") @db.VarChar(255)
  customPermissions     Json?                   @map("custom_permissions")
  hash                  String?                 @db.VarChar(255)
  emailOtpHash          String?                 @map("email_otp_hash") @db.VarChar(255)
  emailOtpExpiresAt     DateTime?               @map("email_otp_expires_at") @db.Timestamptz(3)
  emailOtpLastSentAt    DateTime?               @map("email_otp_last_sent_at") @db.Timestamptz(3)
  emailOtpAttempts      Int                     @default(0) @map("email_otp_attempts")
  isBlocked             Boolean                 @default(false) @map("is_blocked")
  blockedAt             DateTime?               @map("blocked_at") @db.Timestamptz(3)
  isDeleted             Boolean                 @default(false) @map("is_deleted")
  lastLoginAt           DateTime?               @map("last_login_at") @db.Timestamptz(3)
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions              Session[]
  oauthAccounts         OAuthAccount[]
  verificationTokens    AuthVerificationToken[]
  passwordResetTokens   PasswordResetToken[]
  branchAssignments     UserBranchAssignment[]
  patientProfiles       PatientProfile[]
  doctor                Doctor?
  handledInvoices       Invoice[]               @relation("CashierInvoices")
  checkedInAppointments Appointment[]           @relation("CheckedInBy")
  auditLogs             AuditLog[]              @relation("AuditActor")

  @@index([role, status])
  @@index([isBlocked, isDeleted])
  @@map("users")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String?   @map("refresh_token_hash") @db.VarChar(255)
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deletedAt])
  @@map("sessions")
}

model OAuthAccount {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  provider          AuthProvider
  providerAccountId String       @map("provider_account_id") @db.VarChar(255)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model AuthVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("auth_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model UserBranchAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([branchId])
  @@map("user_branch_assignments")
}

model PatientProfile {
  id                    String        @id @default(uuid()) @db.Uuid
  accountId             String?       @map("account_id") @db.Uuid
  fullName              String        @map("full_name") @db.VarChar(100)
  nationalId            String?       @unique @map("national_id") @db.VarChar(20)
  dateOfBirth           DateTime      @map("date_of_birth") @db.Date
  gender                Gender?
  address               String?
  relationshipToAccount String        @default("SELF") @map("relationship_to_account") @db.VarChar(50)
  isMainProfile         Boolean       @default(false) @map("is_main_profile")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  account               User?         @relation(fields: [accountId], references: [id], onDelete: SetNull)
  appointments          Appointment[]
  invoices              Invoice[]

  @@index([accountId, isMainProfile])
  @@map("patient_profiles")
}

model Department {
  id          Int         @id @default(autoincrement())
  name        String      @unique @db.VarChar(100)
  description String?
  doctors     Doctor[]
  specialties Specialty[]

  @@map("departments")
}

model Specialty {
  id           Int               @id @default(autoincrement())
  departmentId Int               @map("department_id")
  name         String            @db.VarChar(100)
  description  String?
  department   Department        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  doctors      DoctorSpecialty[]

  @@unique([departmentId, name])
  @@map("specialties")
}

model Doctor {
  id                 String                    @id @default(uuid()) @db.Uuid
  userId             String                    @unique @map("user_id") @db.Uuid
  departmentId       Int?                      @map("department_id")
  fullName           String                    @map("full_name") @db.VarChar(100)
  academicRank       String?                   @map("academic_rank") @db.VarChar(50)
  consultationFee    Decimal                   @default(0) @map("consultation_fee") @db.Decimal(12, 2)
  isActive           Boolean                   @default(true) @map("is_active")
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  department         Department?               @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  specialties        DoctorSpecialty[]
  branchAssignments  DoctorBranchAssignment[]
  scheduleTemplates  DoctorScheduleTemplate[]
  scheduleExceptions DoctorScheduleException[]
  schedules          DoctorSchedule[]
  appointments       Appointment[]

  @@index([departmentId, isActive])
  @@map("doctors")
}

model DoctorSpecialty {
  doctorId    String    @map("doctor_id") @db.Uuid
  specialtyId Int       @map("specialty_id")
  isPrimary   Boolean   @default(false) @map("is_primary")
  doctor      Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([doctorId, specialtyId])
  @@map("doctor_specialties")
}

model DoctorBranchAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  doctorId  String   @map("doctor_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([doctorId, branchId])
  @@index([branchId])
  @@map("doctor_branch_assignments")
}

model DoctorScheduleTemplate {
  id              String           @id @default(uuid()) @db.Uuid
  doctorId        String           @map("doctor_id") @db.Uuid
  branchId        String           @map("branch_id") @db.Uuid
  dayOfWeek       Int              @map("day_of_week")
  shiftStartTime  DateTime         @map("shift_start_time") @db.Time(0)
  shiftEndTime    DateTime         @map("shift_end_time") @db.Time(0)
  slotDurationMin Int              @map("slot_duration_min")
  defaultCapacity Int              @map("default_capacity")
  validFrom       DateTime         @map("valid_from") @db.Date
  validUntil      DateTime?        @map("valid_until") @db.Date
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  doctor          Doctor           @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  branch          Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  schedules       DoctorSchedule[]

  @@index([doctorId, branchId, dayOfWeek, isActive])
  @@map("doctor_schedule_templates")
}

model DoctorSchedule {
  id         String                  @id @default(uuid()) @db.Uuid
  templateId String?                 @map("template_id") @db.Uuid
  doctorId   String                  @map("doctor_id") @db.Uuid
  branchId   String                  @map("branch_id") @db.Uuid
  roomId     String?                 @map("room_id") @db.Uuid
  workDate   DateTime                @map("work_date") @db.Date
  startTime  DateTime                @map("start_time") @db.Time(0)
  endTime    DateTime                @map("end_time") @db.Time(0)
  status     ScheduleStatus          @default(OPEN)
  createdAt  DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  template   DoctorScheduleTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  doctor     Doctor                  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  branch     Branch                  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  room       ClinicRoom?             @relation(fields: [roomId], references: [id], onDelete: SetNull)
  slots      DoctorScheduleSlot[]

  @@unique([doctorId, branchId, workDate, startTime])
  @@index([branchId, workDate, status])
  @@map("doctor_schedules")
}

model DoctorScheduleSlot {
  id              String         @id @default(uuid()) @db.Uuid
  scheduleId      String         @map("schedule_id") @db.Uuid
  startTime       DateTime       @map("start_time") @db.Time(0)
  endTime         DateTime       @map("end_time") @db.Time(0)
  capacity        Int
  occupiedCount   Int            @default(0) @map("occupied_count")
  nextQueueNumber Int            @default(0) @map("next_queue_number")
  isActive        Boolean        @default(true) @map("is_active")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  schedule        DoctorSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  appointments    Appointment[]

  @@unique([scheduleId, startTime])
  @@index([scheduleId, isActive])
  @@map("doctor_schedule_slots")
}

model DoctorScheduleException {
  id        String   @id @default(uuid()) @db.Uuid
  doctorId  String   @map("doctor_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  date      DateTime @db.Date
  reason    String?
  isClosed  Boolean  @default(true) @map("is_closed")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([doctorId, branchId, date])
  @@map("doctor_schedule_exceptions")
}

model Appointment {
  id                  String                     @id @default(uuid()) @db.Uuid
  bookingCode         String?                    @unique @map("booking_code") @db.VarChar(30)
  patientProfileId    String                     @map("patient_profile_id") @db.Uuid
  doctorId            String                     @map("doctor_id") @db.Uuid
  branchId            String                     @map("branch_id") @db.Uuid
  scheduleSlotId      String                     @map("schedule_slot_id") @db.Uuid
  symptomsDescription String?                    @map("symptoms_description")
  bookedViaAi         Boolean                    @default(false) @map("booked_via_ai")
  status              AppointmentStatus          @default(PENDING_PAYMENT)
  holdExpiresAt       DateTime?                  @map("hold_expires_at") @db.Timestamptz(3)
  queueNumber         Int?                       @map("queue_number")
  checkedInAt         DateTime?                  @map("checked_in_at") @db.Timestamptz(3)
  checkedInById       String?                    @map("checked_in_by_id") @db.Uuid
  createdAt           DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  patientProfile      PatientProfile             @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  doctor              Doctor                     @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  branch              Branch                     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  scheduleSlot        DoctorScheduleSlot         @relation(fields: [scheduleSlotId], references: [id], onDelete: Restrict)
  checkedInBy         User?                      @relation("CheckedInBy", fields: [checkedInById], references: [id], onDelete: SetNull)
  statusHistories     AppointmentStatusHistory[]
  qrToken             AppointmentQrToken?
  invoice             Invoice?

  @@unique([scheduleSlotId, queueNumber])
  @@index([patientProfileId, status])
  @@index([branchId, status, createdAt])
  @@index([scheduleSlotId, status])
  @@map("appointments")
}

model AppointmentStatusHistory {
  id            BigInt             @id @default(autoincrement())
  appointmentId String             @map("appointment_id") @db.Uuid
  fromStatus    AppointmentStatus? @map("from_status")
  toStatus      AppointmentStatus  @map("to_status")
  actorId       String?            @map("actor_id") @db.Uuid
  reason        String?
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  appointment   Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
  @@map("appointment_status_histories")
}

model AppointmentQrToken {
  id            String      @id @default(uuid()) @db.Uuid
  appointmentId String      @unique @map("appointment_id") @db.Uuid
  tokenHash     String      @unique @map("token_hash") @db.VarChar(64)
  expiresAt     DateTime    @map("expires_at") @db.Timestamptz(3)
  usedAt        DateTime?   @map("used_at") @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("appointment_qr_tokens")
}

model Invoice {
  id               String               @id @default(uuid()) @db.Uuid
  appointmentId    String               @unique @map("appointment_id") @db.Uuid
  patientProfileId String               @map("patient_profile_id") @db.Uuid
  branchId         String               @map("branch_id") @db.Uuid
  cashierId        String?              @map("cashier_id") @db.Uuid
  totalAmount      Decimal              @map("total_amount") @db.Decimal(12, 2)
  status           InvoiceStatus        @default(UNPAID)
  paidAt           DateTime?            @map("paid_at") @db.Timestamptz(3)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  appointment      Appointment          @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  patientProfile   PatientProfile       @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  branch           Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  cashier          User?                @relation("CashierInvoices", fields: [cashierId], references: [id], onDelete: SetNull)
  items            InvoiceItem[]
  payments         PaymentTransaction[]

  @@index([branchId, status, createdAt])
  @@map("invoices")
}

model InvoiceItem {
  id          BigInt  @id @default(autoincrement())
  invoiceId   String  @map("invoice_id") @db.Uuid
  description String  @db.VarChar(255)
  quantity    Int     @default(1)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model PaymentTransaction {
  id                    String        @id @default(uuid()) @db.Uuid
  invoiceId             String        @map("invoice_id") @db.Uuid
  provider              String        @db.VarChar(50)
  providerTransactionId String?       @unique @map("provider_transaction_id") @db.VarChar(255)
  idempotencyKey        String        @unique @map("idempotency_key") @db.VarChar(255)
  method                PaymentMethod
  amount                Decimal       @db.Decimal(12, 2)
  status                PaymentStatus @default(PENDING)
  rawPayload            Json?         @map("raw_payload")
  paidAt                DateTime?     @map("paid_at") @db.Timestamptz(3)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  invoice               Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId, status])
  @@map("payment_transactions")
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  aggregateType String       @map("aggregate_type") @db.VarChar(100)
  aggregateId   String       @map("aggregate_id") @db.VarChar(100)
  eventType     String       @map("event_type") @db.VarChar(150)
  payload       Json
  status        OutboxStatus @default(PENDING)
  availableAt   DateTime     @default(now()) @map("available_at") @db.Timestamptz(3)
  publishedAt   DateTime?    @map("published_at") @db.Timestamptz(3)
  attempts      Int          @default(0)
  lastError     String?      @map("last_error")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, availableAt])
  @@map("outbox_events")
}

model ProcessedEvent {
  eventId     String   @id @map("event_id") @db.Uuid
  consumer    String   @db.VarChar(150)
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@index([consumer, processedAt])
  @@map("processed_events")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(150)
  targetType String?  @map("target_type") @db.VarChar(100)
  targetId   String?  @map("target_id") @db.VarChar(100)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}
