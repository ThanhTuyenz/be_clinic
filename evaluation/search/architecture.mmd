flowchart TB
  User["Giao diện tìm kiếm"] --> API["SearchController / SearchService"]
  API --> Parse["Chuẩn hóa câu tìm kiếm<br/>Tách điều kiện và nội dung loại trừ"]
  PG[("PostgreSQL<br/>Danh mục gói khám")] --> Catalog["Danh sách gói đang cung cấp<br/>Cache ứng viên trên Redis"]
  Catalog --> Filter["Lọc gói theo điều kiện truy vấn"]
  Parse --> Filter
  subgraph Rank["SearchRankingService"]
    Filter --> KW["Từ khóa<br/>Tên gói và tên chuyên khoa"]
    Filter --> VS["Tìm kiếm vector HNSW<br/>Lọc theo ID ứng viên<br/>Xếp theo cosine, không ngưỡng cố định"]
    KW --> Merge["Hợp nhất thứ hạng bằng RRF<br/>c = 60, tối đa 50 gói mỗi nhánh<br/>Loại trùng và lấy Top-K"]
    VS --> Merge
  end
  Parse --> QE["Embedding câu tìm kiếm<br/>Cache vector truy vấn"]
  QE <--> OA["OpenAI Embedding API"]
  QE --> VS
  RI[("RedisSearch<br/>Chỉ mục vector HNSW")] --> VS
  PG -. "Khi đồng bộ hoặc cập nhật danh mục" .-> Sync["Đồng bộ embedding gói khám<br/>qua tác vụ nền"]
  Sync <--> OA
  Sync --> RI
  Merge --> Result["Kết quả gói khám"]
  Result --> User
