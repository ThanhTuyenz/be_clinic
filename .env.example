MONGODB_URI=
JWT_SECRET=
PORT=5000
ALLOWED_ORIGINS=http://localhost:3000,https://reggae-daughter-verdict.ngrok-free.dev

# Gửi OTP (đăng ký, quên mật khẩu) và email xác nhận lịch — cần cả hai biến sau.
# Gmail: bật xác minh 2 bước → Tạo "Mật khẩu ứng dụng" → dán vào SMTP_PASS (không dùng mật khẩu đăng nhập thường).
SMTP_USER=
SMTP_PASS=
# Tuỳ chọn: địa chỉ hiển thị người gửi (mặc định = SMTP_USER)
# SMTP_FROM=noreply@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
DATABASE_URL=postgresql://vitacare:vitacare_local@localhost:5432/vitacare?schema=public
DIRECT_URL=postgresql://vitacare:vitacare_local@localhost:5432/vitacare?schema=public
RABBITMQ_URL=amqp://vitacare:vitacare_local@localhost:5672
RABBITMQ_ENABLED=false
# Thời gian giữ chỗ thanh toán (milliseconds), dùng chung cho DB và RabbitMQ. 60000 = 1 phút.
RABBITMQ_HOLD_TTL_MS=900000
RABBITMQ_PREFETCH=10
RABBITMQ_OUTBOX_BATCH_SIZE=50
RABBITMQ_OUTBOX_POLL_MS=3000
PAYMENT_WEBHOOK_SECRET=replace-with-provider-webhook-secret

REDIS_ENABLED=false
# PayOS (VietQR Payment Gateway)

PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:3000/thanh-toan/ket-qua
PAYOS_CANCEL_URL=http://localhost:3000/thanh-toan/ket-qua

# AWS S3 Storage (tự động fallback về /uploads nếu không cấu hình)
AWS_S3_ENABLED=false
AWS_S3_BUCKET=
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_CUSTOM_DOMAIN=

# ==========================================
# CẤU HÌNH HTTPSMS GATEWAY & NOTIFICATIONS
# ==========================================
HTTPSMS_ENABLED=false
HTTPSMS_API_KEY=
HTTPSMS_FROM_NUMBER=+84987654321
HTTPSMS_ENDPOINT=https://api.httpsms.com/v1/messages/send



