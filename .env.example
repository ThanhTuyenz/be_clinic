MONGODB_URI=
JWT_SECRET=
PORT=5000

# Gửi OTP (đăng ký, quên mật khẩu) và email xác nhận lịch — cần cả hai biến sau.
# Gmail: bật xác minh 2 bước → Tạo "Mật khẩu ứng dụng" → dán vào SMTP_PASS (không dùng mật khẩu đăng nhập thường).
SMTP_USER=
SMTP_PASS=
# Tuỳ chọn: địa chỉ hiển thị người gửi (mặc định = SMTP_USER)
# SMTP_FROM=noreply@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
DATABASE_URL=postgresql://vitacare:vitacare_local@localhost:5432/vitacare?schema=public
DIRECT_URL=postgresql://vitacare:vitacare_local@localhost:5432/vitacare?schema=public
RABBITMQ_URL=amqp://vitacare:vitacare_local@localhost:5672
RABBITMQ_ENABLED=false
RABBITMQ_HOLD_TTL_MS=600000
RABBITMQ_PREFETCH=10
RABBITMQ_OUTBOX_BATCH_SIZE=50
RABBITMQ_OUTBOX_POLL_MS=3000
PAYMENT_WEBHOOK_SECRET=replace-with-provider-webhook-secret
REDIS_ENABLED=false
REDIS_URL=redis://:vitacare_local@localhost:6379
REDIS_KEY_PREFIX=vitacare:
REDIS_DB=0
REDIS_DEFAULT_TTL_SECONDS=300
REDIS_CONNECT_TIMEOUT_MS=5000
